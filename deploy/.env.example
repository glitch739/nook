# ~/applications/nook/.env -- keep it private: chmod 600 .env
# Docker-internal paths and the listen address are fixed in
# docker-compose.yml; this file only holds per-installation settings.

# Time zone for log timestamps and backup file names.
TZ=Europe/Budapest

# ---- Home LAN only (before the tunnel is set up) ----
NOOK_PUBLIC_URL=http://<server-ip>:8080
NOOK_COOKIE_SECURE=false
# Email links (verify, password reset) are written to the log:
#   docker compose logs nook | grep -i link
NOOK_DEV_MAIL=log

# ---- Internet, via Cloudflare Tunnel (docs/DEPLOY.md, step 5) ----
# Replace the block above with:
#NOOK_PUBLIC_URL=https://notes.example.com
#NOOK_PUBLISH=127.0.0.1:8080
#CLOUDFLARE_TUNNEL_TOKEN=
# (NOOK_COOKIE_SECURE must be removed: it defaults to true and an https
# public URL refuses to start with false.)

# approval: anyone can sign up, an admin approves each account before
# it can log in (admins see a "waiting" badge). Also the default for an
# https public URL. Other modes: invite | closed | open
NOOK_REGISTRATION=approval

# Only for a brand-new, EMPTY database: creates this admin on first
# start. Delete both lines afterwards.
#NOOK_ADMIN_USERNAME=
#NOOK_ADMIN_PASSWORD=

# Optional real email instead of NOOK_DEV_MAIL=log:
#NOOK_SMTP_HOST=
#NOOK_SMTP_PORT=587
#NOOK_SMTP_USER=
#NOOK_SMTP_PASS=
#NOOK_SMTP_FROM=

# Search inside attached files and Word/OpenDocument previews (ADR 0009):
# needs the tika service (docker compose --profile search up -d). Without
# it, files are searchable by name and e-mails still preview.
#NOOK_TIKA_URL=http://tika:9998
